# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================
# Marketplace Packages (PROPRIETARY — DO NOT SHIP)
# ============================================
# Package source code is uploaded separately to Azure Blob Storage.
# The catalog.json in public/ is the only thing the frontend needs.
# Shipping packages/ to GitHub = giving away the product for free.
packages/

# Ignore build artifacts within packages
packages/**/*.bundle.js
packages/**/*.bundle.js.map
packages/**/dist/

# ============================================
# Build Outputs (Generated - DO NOT COMMIT)
# ============================================
# These are generated by the build script and uploaded to Azure
/dist/bundles/
/dist/zips/

# Package zip files (deployed to Azure, not GitHub)
public/packages/*.zip

# Allow README files in public/packages to be tracked (needed for GitHub Pages)
!public/packages/
!public/packages/*/
!public/packages/*/README.md

# Keep catalog.json tracked (it's the marketplace database for GitHub Pages fallback)
# !public/catalog.json

# ============================================
# Azure & Secrets
# ============================================
.env
.env.local
.env.*.local
*.pem
*.key
